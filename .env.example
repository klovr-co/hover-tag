# Modified by klovr.co in 2026 for Tag. See NOTICE and repository history.
# Copy this file to .env. Do not commit .env or its tokens.

export MFS_URL="http://127.0.0.1:13619"
export MFS_TOKEN=""
export MFS_ALLOWED_SCOPES="file://local/path/to/your/workspace"

# Choose one installed local CLI backend: codex or claude.
export OPENTAG_BACKEND="codex"
# App Server enables semantic streaming, activity status, and Slack Stop.
# Set this to exec only when an operator needs the legacy rollback path.
export OPENTAG_CODEX_TRANSPORT="app-server"
export OPENTAG_BOT_NAME="OpenMax"
export OPENTAG_WORKDIR="/path/to/your/workspace"
# Active tasks may run for up to an hour, but stop after seven quiet minutes.
export OPENTAG_TIMEOUT_SECONDS=420
export OPENTAG_MAX_TIMEOUT_SECONDS=3600
export OPENTAG_BACKEND_ATTEMPTS=3
# Optional comma-separated allowlists for the Slack thread settings modal.
# When OPENTAG_CODEX_MODELS is empty, Tag reads Codex's local model cache.
export OPENTAG_CODEX_MODELS=""
export OPENTAG_CODEX_REASONING_EFFORTS="low,medium,high,xhigh,max,ultra"

# Optional local tools use their own installation, authentication, and access
# configuration. Tag does not maintain separate tool allowlists.

# Slack is the supported chat transport for this release.
export OPENTAG_TRANSPORT="slack"

# Slack app credentials. Create these in your own Slack workspace.
export SLACK_APP_TOKEN="xapp-replace-me"
export SLACK_BOT_TOKEN="xoxb-replace-me"

# Used by preflight checks; the bridge can respond in any channel where the bot
# is a member.
export SLACK_CHANNEL_ID="C0123456789"

# Required comma-separated Slack member IDs allowed to invoke Tag. Setup starts
# with only the owner's ID; add IDs explicitly to share access later.
export SLACK_ALLOWED_USER_IDS="U0123456789"
